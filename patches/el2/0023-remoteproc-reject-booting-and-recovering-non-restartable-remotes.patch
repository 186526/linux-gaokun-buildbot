From fcb191504632591cd0e67b50d31cf9ee71e8adb6 Mon Sep 17 00:00:00 2001
From: linux-gaokun-buildbot <186526@users.noreply.github.com>
Date: Sat, 10 Oct 2026 00:45:31 +0800
Subject: [PATCH] remoteproc: reject booting and recovering non-restartable
 remotes

A remote processor whose ops table has no start() operation can only be
attached to while it is already running. The qcom_q6v5_pas driver selects
such an ops table for qcom,broken-reset remotes, where the PAS reset
sequence is unavailable when running bare-metal without the hypervisor.

Nothing rejected a restart attempt, so a crash pushed the core into
rproc_boot_recovery() -> rproc_start(), which ran the generic ELF loader
(no .load in the ops table) and failed with a misleading 'bad phdr'
error, and reached the unguarded rproc->ops->start() callback.

Reject booting a non-detached remote without start(), and refuse restart
recovery for it, both with -EOPNOTSUPP. The detached attach path and
start-capable remotes are unaffected. Since sysfs can clear the recovery
flag, qcom_q6v5_pas also marks such a remote recovery_disabled so the
guard cannot be bypassed from userspace.
---
 drivers/remoteproc/qcom_q6v5_pas.c   | 10 +++++++
 drivers/remoteproc/remoteproc_core.c | 39 ++++++++++++++++++++++++++--
 2 files changed, 47 insertions(+), 2 deletions(-)

diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index 7286356074..f850cd3be5 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -877,6 +877,16 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	} else {
 		rproc->auto_boot = RPROC_AUTO_BOOT_DISABLED;
 	}
+
+	/*
+	 * Without a start() operation (qcom,broken-reset) the remoteproc can
+	 * only be attached to while it is already running; it cannot be
+	 * restarted after a crash. Disable recovery so the core does not
+	 * attempt an impossible restart. The core also rejects a forced
+	 * recovery, so re-enabling via sysfs cannot bypass this.
+	 */
+	if (!ops->start)
+		rproc->recovery_disabled = true;
 	rproc_coredump_set_elf_info(rproc, ELFCLASS32, EM_NONE);
 
 	pas = rproc->priv;
diff --git a/drivers/remoteproc/remoteproc_core.c b/drivers/remoteproc/remoteproc_core.c
index ddf9d1121d..ada7a72175 100644
--- a/drivers/remoteproc/remoteproc_core.c
+++ b/drivers/remoteproc/remoteproc_core.c
@@ -1260,6 +1260,18 @@ static int rproc_start(struct rproc *rproc, const struct firmware *fw)
 	struct device *dev = &rproc->dev;
 	int ret;
 
+	/*
+	 * A remote processor without a start() operation cannot be powered up
+	 * from scratch; it can only be attached to while it is already running.
+	 * This happens for example with qcom_q6v5_pas when the PAS reset
+	 * sequence is unavailable (qcom,broken-reset). Reject the attempt
+	 * before the generic ELF loader runs, so it fails with an accurate
+	 * error instead of a misleading "bad phdr" from rproc_da_to_va(), and
+	 * before the start() callback is dereferenced.
+	 */
+	if (!rproc->ops->start)
+		return -EOPNOTSUPP;
+
 	/* load the ELF segments to memory */
 	ret = rproc_load_segments(rproc, fw);
 	if (ret) {
@@ -1845,10 +1857,21 @@ int rproc_trigger_recovery(struct rproc *rproc)
 
 	dev_err(dev, "recovering %s\n", rproc->name);
 
-	if (rproc_has_feature(rproc, RPROC_FEAT_ATTACH_ON_RECOVERY))
+	if (rproc_has_feature(rproc, RPROC_FEAT_ATTACH_ON_RECOVERY)) {
 		ret = rproc_attach_recovery(rproc);
-	else
+	} else if (!rproc->ops->start) {
+		/*
+		 * The remote cannot be restarted and no attach-based recovery
+		 * is available. Refuse instead of attempting a boot that is
+		 * guaranteed to fail, which also keeps the NULL start()
+		 * dereference in rproc_start() unreachable.
+		 */
+		dev_err(dev, "can't recover %s: no start operation\n",
+			rproc->name);
+		ret = -EOPNOTSUPP;
+	} else {
 		ret = rproc_boot_recovery(rproc);
+	}
 
 unlock_mutex:
 	mutex_unlock(&rproc->lock);
@@ -1943,6 +1966,18 @@ int rproc_boot(struct rproc *rproc)
 		goto unlock_mutex;
 	}
 
+	/*
+	 * Refuse to boot a remote processor that has no start() operation
+	 * unless it is still in the detached state, where attach() is used
+	 * instead. Attaching only needs attach(), so it remains available;
+	 * a start-capable remote is unaffected.
+	 */
+	if (rproc->state != RPROC_DETACHED && !rproc->ops->start) {
+		dev_err(dev, "can't boot %s: no start operation\n", rproc->name);
+		ret = -EOPNOTSUPP;
+		goto downref_rproc;
+	}
+
 	/* Check early if we have firmware avilable if needed */
 	if (rproc->auto_boot == RPROC_AUTO_BOOT_RESTART_IF_FW_AVAILABLE &&
 	    rproc->state == RPROC_DETACHED) {
-- 
