# Reviewed source inputs. Change these in a commit, together with adaptation notes.
# The kernel commit below is published on the gaokun3 branch.
KERNEL_REPOSITORY=gaokun3/linux
KERNEL_TAG=gaokun3
KERNEL_COMMIT=73033564068250603f5b2150c408554faaf22d66
# EL2 is patch-based: scripts/ci/20_build_kernel_variants.sh applies
# patches/el2 (plus any patches/xanmod/el2 overrides) on top of the prepared
# KERN_SRC tree. There is no separate EL2 commit to check out, so this stays
# empty and is not required for BUILD_EL2=true. It is still exported because the
# Fedora and Ubuntu image workflows read it unconditionally under `set -u`.
KERNEL_EL2_COMMIT=
FEDORA_RELEASE=44
UBUNTU_RELEASE=26.04
