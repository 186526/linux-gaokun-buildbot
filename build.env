# Reviewed source inputs. Change these in a commit, together with adaptation notes.
#
# The kernel is the gaokun3 XanMod fork. Device enablement (defconfig, DTS,
# drivers, EL2 series) lives there as ordinary commits, so this repository only
# fetches the tree and reads gaokun3-manifest.json from its root.
#
# Default build combination: XanMod 7.3.1 device tree + EL2 + KernelSU + Clang
# ThinLTO, with SC8280XP tuning (-march=armv8.4-a+crypto -mtune=cortex-x1c).
# The CI workflows default to this combination: build_el2=true,
# build_kernelsu=true, kernel_toolchain=clang, kernel_tune=sc8280xp.
KERNEL_REPOSITORY=186526/linux-xanmod-gaokun3
# KERNEL_TAG is both the ref fetched from KERNEL_REPOSITORY and the naming label
# the packages and manifest carry. The EL2 variant is fetched from KERNEL_EL2_REF.
KERNEL_TAG=gaokun3
KERNEL_EL2_REF=gaokun3-el2
# Optional exact commit pins. Leave empty to follow the branch tips; set them to
# make a release reproducible. fetch_kernel_tree refuses a ref that resolves to
# a different commit than the pin.
KERNEL_COMMIT=
KERNEL_EL2_COMMIT=
FEDORA_RELEASE=44
UBUNTU_RELEASE=26.04
